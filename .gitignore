.installed.cfg
*.egg
MANIFEST

# Virtual Environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Environment and Secrets (CRITICAL)
.env
.env.*
!.env.example

# Authentication State & Storage (CRITICAL - DO NOT COMMIT SESSIONS)
storage/cookies/*.json
storage/cookies/*
!storage/cookies/.gitkeep

# State Runtime (contém suas tarefas, notas, histórico — NÃO COMMITAR)
storage/state.json
storage/state_backup*.json

# Materials & Submissions (dados gerados/baixados localmente)
storage/materials/*
!storage/materials/.gitkeep
storage/submissions/*
!storage/submissions/.gitkeep


# Playwright
.playwright/
test-results/

# IDE & Editor files
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log
logs/

# AI Agent & Local Config (não commitar configurações locais de agentes)
.agents/
.claude/
.gemini/
skills-lock.json

# Node.js (dependências opcionais de scripts JS)
node_modules/
package-lock.json
package.json

# Scratch / arquivos temporários de análise
scratch/*.py
scratch/*.json
scratch/*.csv

