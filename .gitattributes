# Forçar que scripts de lote e PowerShell do Windows sempre utilizem CRLF (\r\n)
# Evita erros de parsing no cmd.exe ao descompactar pacotes ZIP do GitHub
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Arquivos de código e configurações padrão
*.py text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.example text eol=lf
