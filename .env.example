# ==========================================
# Moodle AI Assistant (UFMG) - Configuração
# ==========================================

# URL base do Moodle da UFMG:
# Para graduação: https://virtual.ufmg.br
MOODLE_BASE_URL=https://virtual.ufmg.br

# Discord Bot - Notificações e Revisão Interativa
# Crie seu bot no Discord Developer Portal e pegue o token
DISCORD_BOT_TOKEN=seu_discord_bot_token_aqui
# ID do canal privado onde as notificações e botões de revisão serão enviados
DISCORD_CHANNEL_ID=000000000000000000
# ID do canal para envio de materiais didáticos e resumos (/adicionarconteudo)
DISCORD_CONTENT_CHANNEL_ID=000000000000000000
# ID do canal para avisos e comunicados dos professores (se 0, usa o canal principal)
DISCORD_ANNOUNCEMENTS_CHANNEL_ID=000000000000000000
# ID do canal para acompanhamento da fila de tarefas em tempo real (se 0, usa o canal principal)
DISCORD_QUEUE_CHANNEL_ID=000000000000000000
# ID do canal para estudos, dúvidas conceituais, simulados e flashcards (se 0, usa o canal onde foi chamado)
DISCORD_STUDY_CHANNEL_ID=000000000000000000
# URL do serviço no Render (ex: https://moodle-discord-bot.onrender.com) para sincronizar submissões remotas
RENDER_URL=

# Google Gemini API
# Obtenha em https://aistudio.google.com/
GEMINI_API_KEY=sua_chave_gemini_api_aqui
# Hierarquia de Modelos (Fallback automático)
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL_1=gemini-3.8-flash
GEMINI_FALLBACK_MODEL_2=gemini-3.7-flash
GEMINI_FALLBACK_MODEL_3=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=90
GEMINI_FALLBACK_TIMEOUT_SECONDS=60
GEMINI_FALLBACK_DELAY_SECONDS=2.0

# Anthropic Claude (BYOK alternativo — deixe em branco para usar Gemini)
# Obtenha em https://console.anthropic.com/
# Se preenchido, Claude substituirá o Gemini como provedor de IA
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# DeepSeek (BYOK alternativo — deixe em branco para usar Gemini)
# Obtenha em https://platform.deepseek.com/
# Se preenchido e ANTHROPIC_API_KEY estiver vazio, DeepSeek será usado
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat


# Configurações de Monitoramento e Agendamento
CHECK_INTERVAL_MINUTES=30
# ATENÇÃO: Se ativado (true), submete o rascunho automaticamente a 1 minuto do encerramento caso você não responda
EMERGENCY_SUBMIT_ENABLED=false

# Armazenamento e Sessão
STORAGE_COOKIES_PATH=storage/cookies/session.json
STORAGE_MATERIALS_DIR=storage/materials
STORAGE_SUBMISSIONS_DIR=storage/submissions

# Opções de Navegador (Playwright)
# False para abrir janela gráfica na primeira vez (necessário para login interativo no MinhaUFMG)
HEADLESS_LOGIN=false
# Tempo limite para você digitar suas credenciais e concluir 2FA na primeira execução (em segundos)
LOGIN_TIMEOUT_SECONDS=300

# Integração com o Notion (Central de Estudos e Tarefas)
NOTION_API_KEY=ntn_seu_token_notion_aqui
NOTION_PAGE_ID=17db4e452b43449a9ca266065840f909
NOTION_TASKS_DATABASE_ID=00e5c698-5139-4b4c-9cac-db04bfc22c4b
NOTION_COURSES_DATABASE_ID=751117de-c4d2-468c-9b46-571c036969b1

